[Unit]
Description=Marshal agent daemon (agentd)
After=marshal-inference.service
Requires=marshal-inference.service

[Service]
Type=simple
WorkingDirectory=__MARSHAL_ROOT__
ExecStart=__MARSHAL_ROOT__/.os/bin/python3 __MARSHAL_ROOT__/agentd.py
Restart=on-failure
RestartSec=3
Environment=HOME=%h
Environment=PYTHONPATH=__MARSHAL_ROOT__

# Resource limits
MemoryMax=1G

# Security hardening
ProtectSystem=strict
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=%h %t

[Install]
WantedBy=marshal-session.target
