[Unit]
Description=Marshal agent daemon (agentd)
After=marshal-inference.service
Requires=marshal-inference.service

[Service]
Type=simple
WorkingDirectory=%h/dev/marshal
ExecStart=%h/dev/marshal/.os/bin/python3 -m agentd
Restart=on-failure
RestartSec=3
Environment=HOME=%h
Environment=PYTHONPATH=%h/dev/marshal

# Resource limits
MemoryMax=1G

# Security hardening
ProtectSystem=strict
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=%h %t

[Install]
WantedBy=marshal-session.target
