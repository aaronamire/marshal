[Unit]
Description=Marshal API server (FastAPI)
After=marshal-agentd.service
Requires=marshal-agentd.service

[Service]
Type=simple
WorkingDirectory=%h/dev/marshal
ExecStart=%h/dev/marshal/.os/bin/uvicorn api.server:app --host 127.0.0.1 --port 8765 --workers 1
Restart=on-failure
RestartSec=3
Environment=HOME=%h
Environment=PYTHONPATH=%h/dev/marshal

# Resource limits
MemoryMax=512M

# Security hardening
ProtectSystem=strict
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=%h %t

[Install]
WantedBy=marshal-session.target
