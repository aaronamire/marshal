[Unit]
Description=Marshal API server (FastAPI)
After=marshal-agentd.service
Requires=marshal-agentd.service

[Service]
Type=simple
WorkingDirectory=__MARSHAL_ROOT__
ExecStart=__MARSHAL_ROOT__/.os/bin/uvicorn api.server:app --host 127.0.0.1 --port 8765 --workers 1
Restart=on-failure
RestartSec=3
Environment=HOME=%h
Environment=PYTHONPATH=__MARSHAL_ROOT__

# Resource limits
MemoryMax=512M

# Security hardening
ProtectSystem=strict
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=%h %t

[Install]
WantedBy=marshal-session.target
