[Unit]
Description=Leaves OS compositor (Wayland)
After=leaves-api.service
Requires=leaves-api.service
# Compositor needs a running graphical session
ConditionEnvironment=XDG_SESSION_TYPE=wayland

[Service]
Type=simple
ExecStart=%h/dev/leaves-os/compositor/builddir/leaves-compositor
Restart=on-failure
RestartSec=3
Environment=HOME=%h
Environment=XDG_CURRENT_DESKTOP=leaves
Environment=XDG_SESSION_TYPE=wayland
Environment=LEAVES_API_URL=http://127.0.0.1:8765

# Compositor needs full access
ProtectSystem=no

[Install]
WantedBy=leaves-session.target
