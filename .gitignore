# Models (too large for git) — exceptions:
#   MANIFEST.sha256       SHA pin used by scripts/download-model.sh
#   layer1_pipeline.joblib  88KB sklearn classifier, required at startup
*.gguf
models/*
!models/MANIFEST.sha256
!models/layer1_pipeline.joblib

# Python
__pycache__/
*.pyc
*.pyo
.venv/
marshal-env/
.os/

# Build artifacts
*.o
*.ko
target/
build/
builddir/

# Runtime
*.db
*.db-shm
*.db-wal
.marshal/
marshal_audit.db

# LanceDB / vector stores — embeddings of user data, never commit
*.lance/
*.lancedb/
rag/.lancedb/
**/.lancedb/

# Images and scratch files
*.jpeg
*.jpg
*.png
WhatsApp*
/tmp/

# OS cruft
.DS_Store
Thumbs.db

# Logs / scratch
*.log
/marshal-boot.log
agentd.log

# Local debugging notes (not for public repo)
OBS_FIX.md

# Editor / IDE caches
.cache/
.clangd/
.vscode/
.idea/
*.swp
*~

# Local runtime state
/.os/
/.marshal/
